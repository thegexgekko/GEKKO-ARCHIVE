{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GEKKO ARCHIVE",
  "version": "0.6.2",
  "identifier": "fr.gekkosoftware.archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GEKKO ARCHIVE",
        "width": 1380,
        "height": 850,
        "minWidth": 950,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0b101b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zip"
        ],
        "name": "Archive ZIP",
        "description": "Archive ZIP (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "7z"
        ],
        "name": "Archive 7z",
        "description": "Archive 7z (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "rar"
        ],
        "name": "Archive RAR",
        "description": "Archive RAR (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "tar"
        ],
        "name": "Archive TAR",
        "description": "Archive TAR (GEKKO ARCHIVE)",
        "role": "Viewer"
      }
    ]
  }
}
