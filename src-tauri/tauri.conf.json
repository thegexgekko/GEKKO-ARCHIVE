{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GEKKO ARCHIVE",
  "version": "0.7.1",
  "identifier": "fr.gekkosoftware.archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GEKKO ARCHIVE",
        "width": 960,
        "height": 630,
        "minWidth": 950,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0b101b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zip"
        ],
        "name": "Archive ZIP",
        "description": "Archive ZIP (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "7z"
        ],
        "name": "Archive 7z",
        "description": "Archive 7z (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "rar"
        ],
        "name": "Archive RAR",
        "description": "Archive RAR (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "tar"
        ],
        "name": "Archive TAR",
        "description": "Archive TAR (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "gz"
        ],
        "name": "Archive GZIP",
        "description": "Archive GZIP (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "xz"
        ],
        "name": "Archive XZ",
        "description": "Archive XZ (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "bz2"
        ],
        "name": "Archive BZIP2",
        "description": "Archive BZIP2 (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "zst"
        ],
        "name": "Archive ZSTD",
        "description": "Archive ZSTD (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "iso"
        ],
        "name": "Archive ISO",
        "description": "Archive ISO (GEKKO ARCHIVE)",
        "role": "Viewer"
      },
      {
        "ext": [
          "cab"
        ],
        "name": "Archive CAB",
        "description": "Archive CAB (GEKKO ARCHIVE)",
        "role": "Viewer"
      }
    ],
    "resources": [
      "resources/7z.exe",
      "resources/7z.dll",
      "resources/LICENSE-7ZIP.txt",
      "windows-dist/GEKKOArchiveContextV0704.dll",
      "windows-dist/GEKKOArchiveShell-v0704.msix",
      "windows-dist/GEKKOArchiveAssets",
      "windows-dist/REGISTER_MENU_V070.ps1"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/gekko-installer-hooks.nsh",
        "languages": [
          "French"
        ]
      }
    }
  }
}
